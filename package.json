{
  "name": "pimx-wide",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-localizations.mjs && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "dev:full": "npm run build && wrangler pages dev dist --config wrangler.local.toml --port 8788",
    "db:local": "wrangler d1 migrations apply PIMX_DB --config wrangler.local.toml --local",
    "admin:secret": "node scripts/admin-secret.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.151.0"
  }
}
